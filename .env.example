# Default schema for `validate-hierarchy local` (override with --schema)
LOCAL_SCHEMA_FILE="schema/local_dataset_root.yml"

# Default schema for `validate-hierarchy irods` (override with --schema)
IRODS_SCHEMA_FILE="schema/dataset_root.yml"

# iRODS environment file (override with --config-file)
IRODS_ENVIRONMENT_FILE="irods_environment.json"

# Email reporting (override with --email-from / --smtp-host)
VALIDATE_HIERARCHY_EMAIL_FROM="noreply-reprocessing@cellgeni-su"
VALIDATE_HIERARCHY_SMTP_HOST="localhost"
