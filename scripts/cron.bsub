#BSUB -G cellgeni
#BSUB -q "basement"
#BSUB -n 1
#BSUB -M 4GB
#BSUB -R "select[mem>4GB] rusage[mem=4GB]"
#BSUB -o "/lustre/scratch124/cellgen/cellgeni/aljes/track_reprocessing/logs/validateOutput%J.log"
#BSUB -e "/lustre/scratch124/cellgen/cellgeni/aljes/track_reprocessing/logs/validateError%J.log"

# Go to the track_reprocessing directory
cd /lustre/scratch124/cellgen/cellgeni/aljes/track_reprocessing

# Load modules
module load cellgen/uv

# Get a list of all collections to validate
iquest --no-page "SELECT COLL_NAME WHERE COLL_PARENT_NAME = '/archive/cellgeni/datasets'" | grep -v "\-\-\-\-" | awk -F' = ' '{print $2}'| sort > logs/collections.txt

# Validate all collections listed in logs/collections.txt
mapfile -t collections < logs/collections.txt
validate-hierarchy irods "${collections[@]}" --email 'ab76@sanger.ac.uk' 'ap41@sanger.ac.uk' --report logs/report.txt --log-file logs/validation_details.log --min-collection-summary 7 --progress-bar

